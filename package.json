{
  "name": "Domain-Manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:ownership": "node --test tests/ownership.test.mjs",
    "test:data": "node --test tests/data-model.test.mjs",
    "test:portfolio": "node --test tests/portfolio*.test.mjs",
    "lint:cleanup": "node scripts/lint-cleanup.mjs",
    "domains:enrich": "node scripts/enrich-domains.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name domain-manager --branch main",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-01-01 --d1=DB -- npm run dev",
    "db:create": "wrangler d1 create domains-db",
    "db:inspect:remote": "wrangler d1 execute domains-db --remote --command \"SELECT name FROM sqlite_schema WHERE type='table' ORDER BY name;\"",
    "db:backup:remote": "mkdir -p backups && wrangler d1 export domains-db --remote --output=./backups/domains-db.sql",
    "db:init:remote": "wrangler d1 execute domains-db --remote --file=./schema.sql --yes",
    "db:migrate:v1.0.2": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.0.2.sql --yes",
    "db:migrate:v1.1.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.1.0.sql --yes",
    "db:migrate:v1.2.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.2.0.sql --yes",
    "db:migrate:v1.3.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.3.0.sql --yes",
    "db:migrate:v1.4.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.4.0.sql --yes",
    "db:migrate:v1.5.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.5.0.sql --yes",
    "db:migrate:v1.6.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.6.0.sql --yes",
    "db:migrate:v1.7.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.7.0.sql --yes",
    "db:migrate:v1.8.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.8.0.sql --yes",
    "db:migrate:v1.9.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.9.0.sql --yes",
    "db:migrate:v1.10.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.10.0.sql --yes",
    "db:migrate:v1.11.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.11.0.sql --yes",
    "db:migrate:v1.12.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.12.0.sql --yes",
    "db:migrate:v1.13.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.13.0.sql --yes",
    "db:migrate:v1.14.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.14.0.sql --yes",
    "db:migrate:v1.15.0": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.15.0.sql --yes",
    "db:verify:remote": "wrangler d1 execute domains-db --remote --command \"SELECT name FROM sqlite_schema WHERE type='table' AND name IN ('websites','domains','website_income','website_effort','website_tasks','website_click_snapshots','website_resources','website_operations','website_ai_notes','website_ai_note_versions','adsense_accounts','adsense_income','provider_accounts','provider_resources','provider_credentials');\"",
    "db:execute": "npm run db:init:remote",
    "db:local": "wrangler d1 execute domains-db --local --file=./schema.sql --yes",
    "deploy": "npm run build && wrangler pages deploy dist --branch main",
    "deploy:full": "npm run build && npm run db:execute && wrangler pages deploy dist --branch main",
    "dev:local": "npm run db:local && npm run pages:dev"
  },
  "dependencies": {
    "element-plus": "^2.9.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4",
    "wrangler": "^4.9.0"
  }
}
