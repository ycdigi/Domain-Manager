    "db:local": "wrangler d1 execute domains-db --local --file=./schema.sql --yes",
    "deploy": "npm run deploy:pages",
    "deploy:full": "npm run deploy:pages",
    "dev:local": "npm run db:local && npm run pages:dev",
    "test:monitor": "node --test tests/monitor*.test.mjs",
    "deploy:monitor": "wrangler deploy --config wrangler.monitor.jsonc --env production",
