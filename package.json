    "db:migrate:v1.27.0": "wrangler d1 execute domains-db --remote --config wrangler.monitor.jsonc --env production --file=./schema-migration-v1.27.0.sql --yes",
    "db:verify:preview": "node scripts/verify-d1.mjs preview",
    "deploy:preview": "npm run build && npm run db:verify:preview && wrangler pages deploy dist --project-name domain-manager --branch preview"
  },
  "dependencies": {
    "element-plus": "^2.9.7",
    "entities": "^4.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "esbuild": "0.25.2",
    "miniflare": "4.20250405.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4",
    "wrangler": "^4.9.0"
  }
