{
  "name": "Domain-Manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:prompts": "node --test tests/prompts.test.mjs",
    "db:migrate:v1.31.0": "wrangler d1 execute domains-db --remote --config wrangler.monitor.jsonc --env production --file=./schema-migration-v1.31.0.sql --yes",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:ownership": "node --test tests/ownership.test.mjs",
    "test:data": "node --test tests/data-model.test.mjs",
    "test:portfolio": "node --test tests/portfolio*.test.mjs",
    "lint:cleanup": "node scripts/lint-cleanup.mjs",
    "domains:enrich": "node scripts/enrich-domains.mjs",
    "deploy:pages": "npm run build && npm run db:verify:remote && wrangler pages deploy dist --project-name domain-manager --branch main",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-01-01 --d1=DB -- npm run dev",
    "db:create": "wrangler d1 create domains-db",
    "db:inspect:remote": "wrangler d1 execute domains-db --remote --config wrangler.monitor.jsonc --env production --command \"SELECT name FROM sqlite_schema WHERE type='table' ORDER BY name;\"",
    "db:backup:remote": "node scripts/backup-d1.mjs production",
    "db:init:remote": "wrangler d1 execute domains-db --remote --file=./schema.sql --yes",
    "db:migrate:v1.0.2": "wrangler d1 execute domains-db --remote --file=./schema-migration-v1.0.2.sql --yes",
